APP_NAME=MF_MANAGER
APP_ENV=development
APP_PORT=8010

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/mf_manager

JWT_SECRET_KEY=change-this-access-secret-key-minimum-32-characters
JWT_REFRESH_SECRET_KEY=change-this-refresh-secret-key-minimum-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
